# x402 gateway (required for x402 mode)
X402_GATEWAY_URL=https://your-x402-gateway.example
X402_PROTOCOL_VERSION=2

# Wallet / chain (implementation-specific; wired in x402-core signer)
X402_CHAIN_ID=eip155:8453
# X402_PRIVATE_KEY=   # dev only — never commit

# Optional Coinbase facilitator
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=

# Discovery (P1)
# X402_DISCOVERY_INDEX_URL=
