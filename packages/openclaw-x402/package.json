{
  "name": "@x402-plugins/openclaw-x402",
  "version": "0.1.0",
  "description": "OpenClaw plugin-sdk provider registration for x402",
  "type": "module",
  "license": "MIT",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
