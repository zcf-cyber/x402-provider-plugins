    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@x402-plugins/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
